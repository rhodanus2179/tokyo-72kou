{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokyo 72 Microseasons dataset",
  "type": "array",
  "minItems": 72,
  "maxItems": 72,
  "items": {
    "type": "object",
    "required": ["id", "month", "start_day", "end_day", "name", "reading", "confidence", "category", "phase"],
    "properties": {
      "id": {"type": "integer", "minimum": 1, "maximum": 72},
      "month": {"type": "integer", "minimum": 1, "maximum": 12},
      "start_day": {"type": "integer", "minimum": 1, "maximum": 31},
      "end_day": {"type": "integer", "minimum": 1, "maximum": 31},
      "name": {"type": "string", "minLength": 1},
      "reading": {"type": "string", "minLength": 1},
      "confidence": {"type": "string", "enum": ["S", "A+", "A", "A−", "B+", "B", "B−"]},
      "category": {"type": "string", "minLength": 1},
      "phase": {"type": "string", "enum": ["開始", "最盛", "開始・最盛"]}
    },
    "additionalProperties": false
  }
}
